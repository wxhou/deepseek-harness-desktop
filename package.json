    "@tailwindcss/vite": "4.1.11",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.6.0",
    "bumpp": "^12.2.1",
    "eslint": "^10.8.1",
